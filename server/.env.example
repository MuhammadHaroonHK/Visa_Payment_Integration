NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Required in development and production. Local example:
# mongodb://127.0.0.1:27017/sahla_payments
# Tests always start an isolated in-memory MongoDB.
MONGODB_URI=

# Checkout.com account configuration. Never expose the secret key, webhook
# signature key or webhook authorization key to the browser.
CHECKOUT_ENVIRONMENT=sandbox
CHECKOUT_API_PREFIX=
CHECKOUT_PUBLIC_KEY=
CHECKOUT_SECRET_KEY=
CHECKOUT_WEBHOOK_SIGNATURE_KEY=
CHECKOUT_WEBHOOK_AUTH_KEY=
CHECKOUT_PROCESSING_CHANNEL_ID=

# Set to true only after the exact HTTPS domain has been onboarded with
# Checkout.com for Apple Pay and enrolled through POST /applepay/enrollments.
CHECKOUT_APPLE_PAY_ENABLED=false
CHECKOUT_APPLE_PAY_DOMAIN=

# Card schemes requested from Flow. Mada in the card form requires a Saudi
# acquirer MID and full capture; confirm this with the account manager.
CHECKOUT_CARD_SCHEMES=visa,mastercard,mada

# Provider HTTP timeout in milliseconds.
CHECKOUT_REQUEST_TIMEOUT_MS=10000
