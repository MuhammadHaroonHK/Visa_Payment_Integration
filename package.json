{
  "name": "saudi-payments-checkout-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Checkout.com Flow checkout for the Saudi market with Cards and Apple Pay.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:client": "npm run test --workspace client",
    "test:server": "npm run test --workspace server",
    "test:watch": "npm run test:watch --workspace client",
    "preview": "npm run preview --workspace client"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
